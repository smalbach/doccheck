{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "doccheck",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/api/dist/main.js"
      ],
      "env": {
        "PORT": "4310",
        "LLM_CACHE_DIR": "eval/cache/ollama_qwen3.8",
        "APP_URL": "http://localhost:4310"
      },
      "port": 4310,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@doccheck/web"
      ],
      "port": 5173,
      "env": {
        "API_URL": "http://localhost:4310"
      }
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "apps/web",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "API_URL": "http://localhost:4310"
      }
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "apps/landing",
        "--port",
        "4320",
        "--strictPort"
      ],
      "port": 4320
    }
  ]
}
