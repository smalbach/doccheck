      "document": "billOfLading",
      "field": "consignee.address.lines[0]",
      "before": "2875 boul. Laurier, bureau 300",
      "after": "2937 boul. Laurier, bureau 300",
      "expectedRuleIds": [
        "X1"
      ],
      "description": "Consignee street address on the BL differs from the invoice."
    },
    {
      "kind": "line_quantity_changed",
      "document": "invoice",
