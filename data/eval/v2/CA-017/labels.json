      "before": "8",
      "after": "80",
      "expectedRuleIds": [
        "X5",
        "X7"
      ],
      "description": "Line 7 quantity changed without updating the line total."
    },
    {
      "kind": "package_count_mismatch",
      "document": "billOfLading",
      "field": "totalPackages",
      "before": 197,
      "after": 207,
      "expectedRuleIds": [
        "X2"
      ],
      "description": "BL declares 207 packages instead of 197."
    }
  ]
