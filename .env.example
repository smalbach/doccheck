# API
PORT=3000

# Postgres: docker-compose credentials, or your local server (create the database first).
# Migrations run on API start; MIGRATE_ON_START=false disables that.
DATABASE_URL=postgres://doccheck:doccheck@localhost:5432/doccheck

# Uploaded PDFs: S3-compatible storage when S3_ENDPOINT is set, otherwise this folder.
STORAGE_DIR=.data/uploads

# Redis for the BullMQ extraction queue (keys prefixed "doccheck"). Unset: extraction runs in-process.
REDIS_URL=redis://localhost:6379
EXTRACTION_CONCURRENCY=1

# Object storage: MinIO from docker compose (:9000) or SeaweedFS via scripts/dev-s3.sh (:9100)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=doccheck
S3_ACCESS_KEY=doccheck
S3_SECRET_KEY=doccheck-secret

# LLM: local models through Ollama
LLM_MODEL=qwen3.8
OLLAMA_BASE_URL=http://localhost:11434
# Embeddings for regulation search (index built with npm run corpus:index)
EMBED_MODEL=bge-m3
# Agent review of ambiguous cases on /validate (also ?agent=false per request)
AGENT_ENABLED=true

# Read-only public demo: no uploads or edits, model answers replayed from eval/cache, samples
# from data/demo (scripts/demo-build.mjs). Needs no Ollama. See docs/DESPLIEGUE.md section 4.
DEMO_READONLY=false

# Every model call is logged to the llm_calls table (local tracing; no external service).

# Accounts: every route but /health and /auth needs a session cookie. A proxy on this machine
# (ngrok, Caddy) terminating HTTPS is trusted for X-Forwarded-*, so the cookie is marked Secure.
# Behind a host's edge proxy (Fly.io, Render) use a hop count: TRUST_PROXY=1.
TRUST_PROXY=loopback

# Admins (comma-separated emails): they can change the model and OCR settings, roles, and see the
# system status from the web. Signing up never makes anyone admin; this list does (also for
# accounts created later). Admin changes are stored in the database and override the values below
# until reset; npm run eval:* keeps reading this file only.
ADMIN_EMAILS=

# Sign-ups: open by default (admins can close it from Settings; ADMIN_EMAILS can always sign up),
# at most this many accounts per client address and hour (requests from this machine are not counted).
REGISTRATION_OPEN=true
SIGNUP_LIMIT_PER_HOUR=5

# Email (password reset links, and conversations with suppliers: docs/MESSAGING.md). Any SMTP server: smtps://user:pass@host:465 (Resend:
# smtps://resend:<API key>@smtp.resend.com:465; Mailgun: smtps://<login>:<password>@smtp.mailgun.org:465).
# Unset: nothing is sent, the email (with the link) is printed in the API log instead (development).
# MAIL_FROM must be an address the provider lets you send from (a verified domain).
SMTP_URL=
MAIL_FROM=DocCheck <no-reply@example.com>
# Where suppliers' replies go. With plus addressing on (the default), each conversation uses
# docs+<token>@example.com, so replies find their conversation even without threading headers.
MAIL_REPLY_TO=
MAIL_PLUS_ADDRESSING=true
# Reading replies: an IMAP mailbox (imaps://user:app-password@imap.example.com:993), polled every
# IMAP_POLL_MS. On the first run it starts after the newest message: the mailbox is not imported.
IMAP_URL=
IMAP_MAILBOX=INBOX
IMAP_POLL_MS=60000
# Or a provider that forwards mail as a webhook: POST /mail/inbound with this secret in X-Inbound-Secret.
MAIL_INBOUND_SECRET=
# Days without an answer after which a request is overdue.
MAIL_FOLLOW_UP_DAYS=3
# Key that seals passwords saved from the web (the mail server settings): 32 bytes as base64
# (openssl rand -base64 32). Unset: a key is made in .data/settings.key. Set it in containers.
SETTINGS_KEY=

# Records retention (docs/ORGANIZATIONS.md): a daily job deletes shipments past their organization's
# retention period (CBSA 6 years, CBP 5 by default) and logs each deletion. RETENTION_JOB=off disables it.
RETENTION_JOB=on
RETENTION_INTERVAL_MS=86400000
# Documents by email (also settable from Admin → Settings → Mailbox): emails with PDFs to a user's
# intake address become shipments that are extracted and validated.
MAIL_INTAKE=false
# Who may send email from the app: all (default) or admins. With open sign-up on a public server,
# set admins (or close registration): otherwise any visitor can send mail from your domain.
MAIL_ALLOWED_SENDERS=all
# Outgoing messages per user per hour and per day, and for the whole server per hour.
MAIL_USER_HOURLY=60
MAIL_USER_DAILY=300
MAIL_SERVER_HOURLY=1000
# Public address of the web app, used to build the links in emails (never taken from the request).
# Unset: http://localhost:5173 (the Vite dev server), except with NODE_ENV=production, where no link
# is sent until it is set.
APP_URL=

# Public tunnel for viewing from another device (scripts/tunnel.sh). The app has its own accounts
# now; the tunnel's user and password (8+ characters) are a second gate in front of it.
NGROK_URL=
NGROK_BASIC_AUTH=

# OCR engine for scanned pages: tesseract (default, runs anywhere) or unlimited (Baidu Unlimited-OCR,
# Apple Silicon only, served by scripts/ocr-server.py; npm run ocr:server).
OCR_ENGINE=tesseract
OCR_URL=http://127.0.0.1:8765

# Integrations (docs/INTEGRATIONS.md). Webhooks, chat alerts, tracking endpoints and SFTP hosts on
# private or local addresses are refused unless this is true (a server inside a company network).
INTEGRATIONS_ALLOW_PRIVATE_URLS=false
# Webhook and chat deliveries: attempts, and the delay before the second (doubled each time).
WEBHOOK_MAX_ATTEMPTS=7
WEBHOOK_BACKOFF_MS=30000
# Folder ingestion: local folders must be inside this one; false stops the periodic checks.
INGEST_LOCAL_ROOT=.data/inbox
INGESTION_ENABLED=true
# X12 interchange ids and usage (T test, P production) of the 856 and 310 exports.
X12_SENDER_ID=DOCCHECK
X12_RECEIVER_ID=RECEIVER
X12_USAGE=T
