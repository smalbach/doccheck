# API
PORT=3000

# Postgres: docker-compose credentials, or your local server (create the database first).
# Migrations run on API start; MIGRATE_ON_START=false disables that.
DATABASE_URL=postgres://doccheck:doccheck@localhost:5432/doccheck

# Uploaded PDFs: S3-compatible storage when S3_ENDPOINT is set, otherwise this folder.
STORAGE_DIR=.data/uploads

# Redis for the BullMQ extraction queue (keys prefixed "doccheck"). Unset: extraction runs in-process.
REDIS_URL=redis://localhost:6379
EXTRACTION_CONCURRENCY=1

# Object storage: MinIO from docker compose (:9000) or SeaweedFS via scripts/dev-s3.sh (:9100)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=doccheck
S3_ACCESS_KEY=doccheck
S3_SECRET_KEY=doccheck-secret

# LLM: local models through Ollama
LLM_MODEL=qwen3.8
OLLAMA_BASE_URL=http://localhost:11434
# Embeddings for regulation search (index built with npm run corpus:index)
EMBED_MODEL=bge-m3
# Agent review of ambiguous cases on /validate (also ?agent=false per request)
AGENT_ENABLED=true

# Read-only public demo: no uploads or edits, model answers replayed from eval/cache, samples
# from data/demo (scripts/demo-build.mjs). Needs no Ollama. See docs/DESPLIEGUE.md section 4.
DEMO_READONLY=false

# Every model call is logged to the llm_calls table (local tracing; no external service).

# Accounts: every route but /health and /auth needs a session cookie. A proxy on this machine
# (ngrok, Caddy) terminating HTTPS is trusted for X-Forwarded-*, so the cookie is marked Secure.
TRUST_PROXY=loopback

# Admins (comma-separated emails): they can change the model and OCR settings, roles, and see the
# system status from the web. Signing up never makes anyone admin; this list does (also for
# accounts created later). Admin changes are stored in the database and override the values below
# until reset; npm run eval:* keeps reading this file only.
ADMIN_EMAILS=

# Sign-ups: open by default (admins can close it from Settings; ADMIN_EMAILS can always sign up),
# at most this many accounts per client address and hour (requests from this machine are not counted).
REGISTRATION_OPEN=true
SIGNUP_LIMIT_PER_HOUR=5

# Email ("Forgot password?" links). Any SMTP server: smtps://user:pass@host:465 (Resend:
# smtps://resend:<API key>@smtp.resend.com:465; Mailgun: smtps://<login>:<password>@smtp.mailgun.org:465).
# Unset: nothing is sent, the email (with the link) is printed in the API log instead (development).
# MAIL_FROM must be an address the provider lets you send from (a verified domain).
SMTP_URL=
MAIL_FROM=DocCheck <no-reply@example.com>
# Public address of the web app, used to build the links in emails (never taken from the request).
# Unset: http://localhost:5173 (the Vite dev server), except with NODE_ENV=production, where no link
# is sent until it is set.
APP_URL=

# Public tunnel for viewing from another device (scripts/tunnel.sh). The app has its own accounts
# now; the tunnel's user and password (8+ characters) are a second gate in front of it.
NGROK_URL=
NGROK_BASIC_AUTH=
